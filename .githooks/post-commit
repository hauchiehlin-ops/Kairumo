#!/usr/bin/env bash
# exFAT：git 剛寫過 pack／索引，macOS 在旁邊生出的 `._*` 會讓下一個 git 指令噴
# non-monotonic index。寫完當下就清（只清 .git 內部，見 scripts/clean-appledouble.sh）。
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
"${REPO_ROOT}/scripts/clean-appledouble.sh" --git-only >/dev/null 2>&1 || true

# 若本次 commit 係基於先前已通過驗證之狀態提交，自動將守門機制快取推進至新產生的 HEAD commit
COMMITTING_FLAG="${REPO_ROOT}/.git/gatekeepers.committing"
if [[ -f "$COMMITTING_FLAG" ]]; then
    rm -f "$COMMITTING_FLAG"
    head_sha="$(git rev-parse HEAD 2>/dev/null || echo "no-head")"
    diff_head="$(git diff HEAD 2>/dev/null || echo "no-diff")"
    staged_head="$(git diff --cached 2>/dev/null || echo "no-staged")"
    mkdir -p "${REPO_ROOT}/.git"
    printf "%s\n%s\n%s" "$head_sha" "$diff_head" "$staged_head" | shasum -a 256 | awk '{print $1}' > "${REPO_ROOT}/.git/gatekeepers.passed" 2>/dev/null || true
fi

exit 0
