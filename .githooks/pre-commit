#!/usr/bin/env bash
#
# .githooks/pre-commit
# 自動在 commit 前檢查並同步衍生產物（手冊、隱私權政策、範本）
#
set -euo pipefail
export PYTHONIOENCODING=utf-8

REPO_ROOT="$(git rev-parse --show-toplevel)"

# exFAT 上 macOS 會到處生出 `._*`／`.DS_Store`：.git 裡的會讓 git 報 non-monotonic index。
# commit 前用 `--git-only` 快速清理 .git 關鍵目錄，避免在 exFAT 外接碟上全庫 find 卡住。
"${REPO_ROOT}/scripts/clean-appledouble.sh" --git-only || true

# 檢查暫存區中是否包含來源手冊、法規、範本或版本檔案
STAGED_SOURCES=$(git diff --cached --name-only | grep -E '^(docs/manual/manual\.js|docs/legal/privacy\.html|Cargo\.toml|templates/src/)' || true)

if [[ -n "$STAGED_SOURCES" ]]; then
    echo "📄 偵測到手冊、隱私權政策、範本或版本來源檔案變更，自動重新產生衍生平台產物..."
    
    python3 "${REPO_ROOT}/scripts/build-platform-docs.py" >/dev/null
    python3 "${REPO_ROOT}/scripts/build-privacy-docs.py" >/dev/null
    python3 "${REPO_ROOT}/scripts/doc_templates_tool.py" build >/dev/null
    
    # 自動將產物加入本次 commit，徹底杜絕手動遺漏造成的 CI 失敗
    git add "${REPO_ROOT}/docs/manual/manual-apple.js" \
            "${REPO_ROOT}/docs/manual/manual-android.js" \
            "${REPO_ROOT}/docs/legal/privacy-apple.html" \
            "${REPO_ROOT}/docs/legal/privacy-android.html" \
            "${REPO_ROOT}/templates/document-templates.json" \
            "${REPO_ROOT}/apple/Resources/Docs/manual-apple.js" \
            "${REPO_ROOT}/apple/Resources/Docs/privacy.html" 2>/dev/null || true
    echo "✅ 衍生平台檔案已自動同步並納入暫存區。"
fi

# 檢查暫存區中是否包含介面程式碼（Swift / Kotlin），若有則僅針對暫存區變更檔案檢查是否有硬寫死文字（避免在 exFAT 外接碟上全庫 rglob 掃描數百個檔案造成數分鐘卡頓）
STAGED_UI_FILES=()
while IFS= read -r line; do
    [[ -n "$line" ]] && STAGED_UI_FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(swift|kt)$' || true)

if [[ ${#STAGED_UI_FILES[@]} -gt 0 ]]; then
    if [[ -f "${REPO_ROOT}/scripts/check-hardcoded-strings.py" ]]; then
        if ! python3 "${REPO_ROOT}/scripts/check-hardcoded-strings.py" "${STAGED_UI_FILES[@]}"; then
            echo "" >&2
            echo "❌ [Pre-Commit 阻擋] 介面上發現硬寫死的文字，提交已被阻止！" >&2
            echo "💡 永久解決辦法：" >&2
            echo "   1. 跑 python3 scripts/i18n_tool.py add <鍵名> \"<中文>\" [\"英文\"] 自動登錄字串表" >&2
            echo "   2. 在程式碼中改用 localized(\"鍵名\")" >&2
            echo "   3. 重新 git add 並 commit 即可。" >&2
            exit 1
        fi
    fi
fi

exit 0

