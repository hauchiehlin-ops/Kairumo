#!/usr/bin/env bash
# exFAT：git 剛寫過 pack／索引，macOS 在旁邊生出的 `._*` 會讓下一個 git 指令噴
# non-monotonic index。寫完當下就清（只清 .git 內部，見 scripts/clean-appledouble.sh）。
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
"${REPO_ROOT}/scripts/clean-appledouble.sh" --git-only >/dev/null 2>&1 || true
exit 0
