<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 錄音（第一版不含語音轉錄，但錄音本身仍可用） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 線上協同：連使用者自己輸入的 ws:// 位址，不經任何外部伺服器 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      區網直連（秒同步）。NSD 發現服務與網路狀態監聽（自動同步的「網路恢復」觸發）
      用到這兩個，都是一般權限、不會跳出授權對話框。
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
        這裡原本還有 ACCESS_WIFI_STATE 與 NEARBY_WIFI_DEVICES，**程式裡從來
        沒有用過**，宣告了卻不用的危險權限換來的是商店頁面上一條「附近的裝置」，
        以及 Play Console 要你解釋用途。

        現在有了 NsdManager（區網直連，`sync/LanLink.kt`），但它**不需要**這兩個：
        NSD 只走 mDNS，不掃描 Wi-Fi、不碰 Wi-Fi Direct。上面那兩個一般權限
        （ACCESS_NETWORK_STATE、CHANGE_WIFI_MULTICAST_STATE）就夠了，
        所以這兩個仍然不加。
    -->

    <uses-feature android:name="android.hardware.touchscreen.stylus" android:required="false" />

    <!--
        協同中繼在區域網路或本機上走 ws://，那是明文連線，而 Android 9 以上
        預設整個擋掉。擋掉的症狀是「一直重連但永遠連不上」，而且不會有任何
        錯誤訊息指向這裡。

        **明文只到區網為止。** 核心的 `collab_check_server` 會在連線之前擋掉
        指向公開網路的 `ws://`，要求改用 `wss://` —— 兩個平台走同一個判斷。
        所以這個旗標放行的實際範圍是：本機、RFC 1918 私有網段、連結本地
        與 `.local`，其餘一律連不出去。

        為什麼不用 network security config 來擋：那份設定只吃固定的主機名，
        表達不了「任何私有網段」—— 區網中繼的位址是使用者當下那台機器的
        DHCP 位址，每次都不一樣。判斷只能在程式裡做。

        oplog 的內容本身是端對端加密的（見 ffi_collab.rs），中繼與路上的
        任何人拿到的都只是密文；但房號、成員與流量樣態是明文，這正是
        公開網路上必須用 wss:// 的理由。
    -->
        <!-- 套件可見性（API 30+）：沒有宣告的話，`queryIntentActivities` 一律回空，
         「裝置自檢」會誤報『沒有檔案選擇器』。只宣告我們實際會問的那一個動作。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:label="Kairumo"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kairumo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Kairumo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 外部點擊 .padnote 筆記檔直接以此 App 開啟匯入 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.padnote" />
                <data android:host="*" />
            </intent-filter>
        </activity>

        <!--
            Google OAuth 的 redirect 接收端。

            使用者在 Custom Tabs 裡授權完，Google 會跳轉到這個自訂 scheme，
            由這個 activity 把授權碼交回 App。

            scheme **必須與核心 `oauthUrlScheme(ANDROID)` 完全一致**（反轉的
            client id）。不一致的話，使用者授權完會回不到 App —— 瀏覽器停在
            一個打不開的網址上，而且沒有任何錯誤訊息指向這裡。

            `exported="true"` 是必要的：跳轉是從瀏覽器（另一個 App）進來的。
            這個 activity 不接受任何其他輸入，只解析授權碼。
        -->
        <activity
            android:name=".oauth.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.googleusercontent.apps.155748821200-ff0a8ni2tsfdct1j2877t01kpjdiv5mi" />
            </intent-filter>
        </activity>
        <!-- 匯出檔的分享。授權是逐次、暫時的，不開放整個目錄。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
