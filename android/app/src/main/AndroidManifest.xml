<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 錄音（第一版不含語音轉錄，但錄音本身仍可用） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 線上協同：同一個 Wi-Fi 下直接連線，不經任何外部伺服器 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <uses-feature android:name="android.hardware.touchscreen.stylus" android:required="false" />

    <!--
        協同中繼走 ws://（區域網路或本機），那是明文連線，而 Android 9 以上
        預設整個擋掉。擋掉的症狀是「一直重連但永遠連不上」，而且不會有任何
        錯誤訊息指向這裡。

        放行明文的代價在這個 App 上很小：網路流量只有一種 —— 使用者自己
        指定的協同中繼；而 oplog 的內容是**端對端加密**的（見 ffi_collab.rs），
        中繼與路上的任何人拿到的都只是密文。
        走公開網路時仍然建議用 wss://。
    -->
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:label="Kairumo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kairumo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Kairumo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 匯出檔的分享。授權是逐次、暫時的，不開放整個目錄。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
