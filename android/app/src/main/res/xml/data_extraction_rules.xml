<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以上的備份與裝置轉移規則。理由同 backup_rules.xml。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="kairumo.profilelock.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="kairumo.profilelock.xml" />
    </device-transfer>
</data-extraction-rules>
