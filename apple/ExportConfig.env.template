# ==============================================================================
# Apple 打包與 App Store Connect 上傳設定檔範本
# 使用方法：複製此檔案為 apple/ExportConfig.env 並填寫您的開發者資訊
#   cp apple/ExportConfig.env.template apple/ExportConfig.env
# ==============================================================================

# 1. 基本專案資訊
# 您的 Apple Developer Team ID（10 碼英數字，可在 developer.apple.com 會員中心右上角取得）
APPLE_TEAM_ID="YOUR_TEAM_ID_HERE"

# 應用程式 Bundle Identifier（需與 App Store Connect 上的 Identifier 一致）
BUNDLE_ID="com.kairumo.padnote"

# Xcode 專案路徑（若放置於 apple/Kairumo.xcodeproj）
PROJECT_PATH="apple/Kairumo.xcodeproj"

# Xcode Scheme 名稱（預設為 App 名稱）
SCHEME="Kairumo"

# 2. 上傳驗證方式（二選一，推薦方式 A：API Key）

# 【方式 A：App Store Connect API Key（推薦 CI/CD 與腳本使用，免雙重驗證）】
# 在 App Store Connect ->「使用者與存取權」->「整合/API 金鑰」中建立
APP_STORE_CONNECT_API_KEY_ID=""      # 例：D3ABC12345
APP_STORE_CONNECT_ISSUER_ID=""      # 例：69a6de70-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_KEY_PATH=""       # AuthKey_D3ABC12345.p8 的絕對路徑

# 【方式 B：Apple ID 與 App 專用密碼（若未申請 API Key）】
# 專用密碼請在 appleid.apple.com ->「登入與安全」->「App 專用密碼」產生
APPLE_ID=""                         # 您的 Apple 帳號 Email
APP_SPECIFIC_PASSWORD=""            # 產生的 16 碼專用密碼（格式如 abcd-efgh-ijkl-mnop）
