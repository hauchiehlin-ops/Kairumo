/target
**/*.rs.bk
.DS_Store

# 模型權重按需下載，永不入版控（D4）
/models/cache/
/models/*.onnx
/models/*.bin
/models/*.gguf

# ASR 測試集音檔（體積大，另行管理）
/crates/padnote-bench/fixtures/audio/

# Apple
xcuserdata/
*.xcuserstate
DerivedData/

# UniFFI 綁定為衍生檔案，由 scripts/generate-bindings.sh 產生。
# 與 core API 不同步的綁定比沒有更危險，因此不進版控。
/apple/Generated/
/android/Generated/
/apple/PadnoteCore.xcframework/
/apple/ExportConfig.env
/build/apple/

# 自行匯出的模型（ADR-0006）。檔案太大不入版控，
# 但 PROVENANCE.json 是授權證據，必須保留。
/models/exported*/**/*.onnx
/models/exported*/**/*.mvn
/models/exported*/**/tokens.json

# Android 衍生檔（由 scripts/build-android-libs.sh 產生，不進版控）
/android/app/src/main/jniLibs/
/android/prebuilt/
/android/app/src/main/java/uniffi/
/android/build/
/android/app/build/
/android/.gradle/
/android/local.properties
__pycache__/

# build/ 整個是建置輸出，一律不進版控。
#
# 原本只擋了 /build/apple/ 與 /build/dist/，結果一次 `git add -A` 把
# build/DerivedDataMac（Xcode 的衍生資料，3931 個檔、344MB）整包提交進去。
# 用列舉的方式擋目錄，遲早會漏掉下一個 —— 直接擋整層。
/build/

# 第三方原始碼與中間產物（不要放進 target/，CI 的 rust-cache 會修剪它）
/.build/

# Kotlin 編譯器的錯誤暫存（每次建置都會變，不是原始碼）
/android/.kotlin/

# libpdfium 執行期庫（scripts/fetch-pdfium.sh 抓下來的）。
# 每個平台 3～4 MB，而且是可以重抓、雜湊驗得過的衍生物。
/third_party/pdfium/
